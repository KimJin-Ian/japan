# 복사해서 .env.local 로 만들고 값을 채운다. .env.local 은 git에 올리지 않는다.

# 배포 주소 (사이트맵 · OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — 공개용 (브라우저에 노출돼도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — 비밀 (서버·수집기 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다)
SUPABASE_SECRET_KEY=

# 겸사겸사 부탁 작성 화면 주소. 비워 두면 '구매 부탁 출시 알림 받기'가 대신 나온다
NEXT_PUBLIC_GYEOMSA_REQUEST_URL=

# 관리자 화면 Basic 인증. 배포 환경에서 비어 있으면 /admin 은 404
ADMIN_USER=
ADMIN_PASSWORD=

# 수집기 · AI 분석 (Phase 3~4)
ANTHROPIC_API_KEY=
# 번역·분류 모델 (기본 claude-opus-5-5, 비용을 줄이려면 claude-haiku-5-5)
ANALYZE_MODEL=
YAHOO_JP_CLIENT_ID=

# 검색엔진 소유 확인 값 (구글 서치 콘솔 · 네이버 서치어드바이저에서 받은 content 값)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
